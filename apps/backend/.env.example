# Copy this file to .env and fill in real values.

# Anthropic API key for classification, reply generation and the safety post-check.
ANTHROPIC_API_KEY=

# Model used for all three LLM calls in the pipeline.
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite connection strings. These stand in for Google Sheets (source) and
# Postgres (AI zone) in this prototype. See apps/backend/prisma/*.prisma.
DATABASE_URL_SOURCE="file:./source.db"
DATABASE_URL_AIZONE="file:./aizone.db"

# Backend port.
PORT=4000

# WhatsApp Cloud API (Meta) — only needed if you go the Meta route (requires
# business verification for anything beyond the free test number).
# VERIFY_TOKEN is any string you make up — enter the same value in Meta's
# webhook config.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=fitelo-dev-verify
WHATSAPP_API_VERSION=v21.0

# Twilio WhatsApp Sandbox — no business verification needed. Get
# ACCOUNT_SID / AUTH_TOKEN from the Twilio Console dashboard, and
# WHATSAPP_FROM from the Sandbox page (it's their fixed sandbox number,
# looks like "whatsapp:+14155238886").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
