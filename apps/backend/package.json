{
  "name": "@aihb/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:generate": "prisma generate --schema prisma/source.prisma && prisma generate --schema prisma/aizone.prisma",
    "db:push": "prisma db push --schema prisma/source.prisma && prisma db push --schema prisma/aizone.prisma",
    "seed": "tsx src/seed/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aihb/shared": "*",
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
